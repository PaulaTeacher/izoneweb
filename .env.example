# ==========================================
# iZone Tech — Variables de Entorno
# Copia este archivo a apps/api/.env
# ==========================================

# --- BASE DE DATOS (SQLite - Local Dev) ---
DATABASE_URL="file:./dev.db"

# --- BACKEND (NestJS) ---
PORT=3001
JWT_SECRET="cambiar-por-un-secret-seguro-generar-con-openssl-rand-hex-32"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# --- FRONTEND (Next.js) ---
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WHATSAPP_NUMBER="573001234567"
# Dominio canónico de producción (obligatorio para SEO correcto)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- CLOUDINARY (imágenes — Fase 5) ---
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# --- SEO / ANALYTICS / VERIFICACIÓN ---
# Google Analytics 4 Measurement ID (G-XXXXXXXX)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=""
# Alias legacy:
# NEXT_PUBLIC_GA_ID=""
# Google Tag Manager (si usas GTM, no hace falta GA_ID directo)
# NEXT_PUBLIC_GTM_ID=""
# Meta Pixel (opcional)
# NEXT_PUBLIC_META_PIXEL_ID=""
# Search Console / Bing (meta verification)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
# NEXT_PUBLIC_BING_SITE_VERIFICATION=""

# --- SENTRY (Fase 5) ---
# SENTRY_DSN=""

# --- ERP CONECTIK (Future-Proof) ---
# ERP_API_URL="https://us-central1-tu-proyecto.cloudfunctions.net/api"
# ERP_API_KEY=""

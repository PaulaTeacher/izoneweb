# ==========================================
# iZone Tech API — variables de entorno
# Copia este archivo a apps/api/.env y rellena los valores.
# NUNCA subas el .env real al repo. En Cloud Run, los secretos van en Secret Manager.
# ==========================================

NODE_ENV=development
# Cloud Run inyecta PORT automáticamente.
PORT=3001

# --- BASE DE DATOS (Supabase Postgres) ---
# Pooler en modo transacción (puerto 6543): Prisma necesita pgbouncer=true y connection_limit=1.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Conexión directa/session (puerto 5432): solo para migraciones (prisma migrate / db push).
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# --- AUTH (admin) ---
# Generar con: openssl rand -hex 32
JWT_SECRET=""
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# --- CORS ---
# Dominio de la web (origen permitido). En producción: https://<dominio>
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- WHATSAPP ---
# Solo dígitos, con código de país. Debe ser el número REAL de la tienda en producción.
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# --- CRON (liberación de reservas vencidas) ---
# Token que Cloud Scheduler envía en la cabecera X-Cron-Secret a POST /cron/release-expired.
# Generar con: openssl rand -hex 32. Si está vacío, el endpoint responde 503.
CRON_SECRET=""
# Cron interno cada 5 min (útil en dev). Si no se define: activo salvo con NODE_ENV=production.
# En Cloud Run dejarlo en false y usar Cloud Scheduler.
# ENABLE_INTERNAL_CRON=true
